# PostgreSQL connection for the MediKiosk API server.
# Local dev (docker compose up -d db):
DATABASE_URL=postgres://medikiosk:medikiosk@127.0.0.1:5432/medikiosk
# Production example (Neon / RDS / self-hosted — use secret management, not commits):
# DATABASE_URL=postgres://user:password@db.internal.example:5432/medikiosk?sslmode=require

PORT=3001
# DB_POOL_MAX=10
