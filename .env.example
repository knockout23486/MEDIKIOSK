# PostgreSQL connection for the MediKiosk API server.
DATABASE_URL=postgres://medikiosk:medikiosk@127.0.0.1:5432/medikiosk

# SEC-003 — HS256 signing secret for API JWTs (openssl rand -hex 32).
AUTH_JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# SEC-004 — AES-256-GCM key encrypting PHI fields at the application layer
# (openssl rand -hex 32). WARNING: rotating this key makes existing ciphertext
# unreadable; keep a secure backup.
APP_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

PORT=3001
# DB_POOL_MAX=10
